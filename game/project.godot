; Engine configuration file.
config_version=5

[application]

config/name="MilkTeaHouse"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://assets/icons/app/icon_1024.png"

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameData="*res://autoload/game_data.gd"
GameState="*res://autoload/game_state.gd"
GameLocale="*res://autoload/game_locale.gd"
LegacyRoutes="*res://autoload/legacy_routes.gd"
RecipeJournal="*res://autoload/recipe_journal.gd"
MenuCatalog="*res://autoload/menu_catalog.gd"
ResearchProgress="*res://autoload/research_progress.gd"
ResearchBriefs="*res://autoload/research_briefs.gd"
MarketTests="*res://autoload/market_tests.gd"
OperatingCosts="*res://autoload/operating_costs.gd"
DailyEvents="*res://autoload/daily_events.gd"
UpgradeCatalog="*res://autoload/upgrade_catalog.gd"
StaffCatalog="*res://autoload/staff_catalog.gd"
EndlessContracts="*res://autoload/endless_contracts.gd"
RecipeLab="*res://autoload/recipe_lab.gd"
InputPrompts="*res://autoload/input_prompts.gd"
DisplayPrefs="*res://autoload/display_prefs.gd"
Haptics="*res://autoload/haptics.gd"
Sfx="*res://autoload/sfx.gd"

[internationalization]

locale/fallback="zh_CN"
locale/translations=PackedStringArray("res://localization/ui.en.translation", "res://localization/ui.zh_CN.translation")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
